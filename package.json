{
  "name": "@illicomedia/skills-mcp-server",
  "mcpName": "io.github.illicomedia/skills-mcp-server",
  "version": "3.2.0",
  "description": "MCP server that gives AI coding agents QA skills and a local code audit: security, accessibility, performance, GDPR, DevOps and more.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fredo-qa-mcp-server": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illicomedia/skills-mcp-server.git"
  },
  "homepage": "https://www.illicomedia.com/qa-skills/mcp",
  "bugs": {
    "url": "https://github.com/illicomedia/skills-mcp-server/issues"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc && node scripts/postbuild.mjs",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/index.js",
    "lint": "biome check --error-on-warnings src tests scripts",
    "prelint:types": "pnpm run build",
    "lint:types": "tsc -p tsconfig.test.json",
    "lint:package": "publint --strict",
    "prelint:dead": "pnpm run build",
    "lint:dead": "knip",
    "lint:duplicates": "jscpd",
    "pretest": "pnpm run build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "pretest:coverage": "pnpm run build",
    "test:coverage": "node scripts/run-coverage.mjs",
    "check": "pnpm run lint && pnpm run lint:types && pnpm run lint:dead && pnpm run lint:duplicates && pnpm run test:coverage && pnpm run release:smoke",
    "check:clean": "node scripts/check-clean.mjs",
    "release": "node scripts/release.mjs",
    "release:smoke": "node scripts/release.mjs --smoke-only",
    "github:check": "node scripts/github-settings.mjs --check",
    "github:apply": "node scripts/github-settings.mjs --apply",
    "github:audit": "bash scripts/github-audit.sh"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "ai-coding",
    "agent-skills",
    "code-quality",
    "code-review",
    "code-audit",
    "qa",
    "quality-assurance",
    "quality-gates",
    "security",
    "accessibility",
    "performance",
    "gdpr",
    "devops"
  ],
  "author": "Frédéric Ch. V. <72545167+fcviallet@users.noreply.github.com> (https://github.com/fcviallet)",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "publint": "0.3.25",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  }
}
