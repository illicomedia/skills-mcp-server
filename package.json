{
  "name": "@illicomedia/skills-mcp-server",
  "version": "1.4.3",
  "description": "MCP server that gives AI coding agents QA skills and a local code audit: security, accessibility, performance, GDPR, DevOps and more.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fredo-qa-mcp-server": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcviallet/skills.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://www.illicomedia.com/qa-skills/mcp",
  "bugs": {
    "url": "https://github.com/fcviallet/skills/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && chmod -R u+rwX dist",
    "prepublishOnly": "pnpm run build",
    "release": "node scripts/release.mjs",
    "release:smoke": "node scripts/release.mjs --smoke-only",
    "start": "node dist/index.js",
    "lint": "../../website/node_modules/.bin/biome check --error-on-warnings src tests scripts",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/*.test.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "ai-coding",
    "agent-skills",
    "code-quality",
    "code-review",
    "code-audit",
    "qa",
    "quality-assurance",
    "quality-gates",
    "security",
    "accessibility",
    "performance",
    "gdpr",
    "devops",
    "claude-desktop",
    "cursor",
    "copilot",
    "windsurf"
  ],
  "author": "Frédéric Ch. V. <72545167+fcviallet@users.noreply.github.com> (https://github.com/fcviallet)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
