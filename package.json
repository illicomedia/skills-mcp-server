{
  "name": "@illicomedia/skills-mcp-server",
  "version": "1.3.2",
  "description": "Official Fredo QA Skills Model Context Protocol (MCP) Server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@12.15.0",
  "bin": {
    "fredo-qa-mcp-server": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcviallet/skills.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://www.illicomedia.com/qa-skills/mcp",
  "bugs": {
