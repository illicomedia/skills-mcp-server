{
  "name": "fredo-qa-skills-website",
  "author": "Example Author <author@example.invalid>",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12",
      "onFail": "warn"
    }
  },
  "description": "Fredo QA Skills website - production-grade QA skills for modern software",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "test": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:lighthouse",
    "test:all": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:lighthouse && pnpm run validate:w3c",
    "catalog:sync": "python3 ../scripts/catalog/import_manifests.py --root .. --skip-db --snapshot src/data/generated/catalog.snapshot.json",
    "predev": "pnpm run catalog:sync",
    "prebuild": "pnpm run catalog:sync",
    "build:well-known": "node scripts/generate-well-known.js --mode prod",
    "build": "node scripts/generate-well-known.js --mode prod && node scripts/generate-epub.js && tsc && vite build --mode prod && node scripts/generate-seo-pages.js --mode prod && node scripts/audit-secrets.js && node ../scripts/package-ovh-deploy.js",
    "build:prod": "pnpm run build",
    "audit:secrets": "node scripts/audit-secrets.js",
    "lighthouse:audit": "node scripts/audit-lighthouse.js --strict",
    "test:lighthouse": "node scripts/audit-lighthouse.js --strict --allow-skip-no-browser",
    "preview": "vite preview",
    "lint": "biome lint --error-on-warnings src/ tests/",
    "lint:fix": "biome lint --write src/ tests/",
    "format": "biome format --write ./src ./tests",
    "format:check": "biome format ./src ./tests",
    "check": "biome check --error-on-warnings ./src ./tests",
    "check:fix": "biome check --write ./src ./tests",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-playwright.js test",
    "test:e2e:ui": "node scripts/run-playwright.js test --ui",
    "test:e2e:headed": "node scripts/run-playwright.js test --headed",
    "test:accessibility": "node scripts/run-playwright.js test accessibility.spec.ts",
    "test:performance": "node scripts/run-playwright.js test performance.spec.ts",
    "test:seo": "node scripts/run-playwright.js test seo.spec.ts",
    "fix": "pnpm run lint:fix && pnpm run format",
    "qa:starter": "pnpm run type-check && pnpm run lint && pnpm run format:check",
    "qa:standard": "pnpm run qa:starter && pnpm run test:unit:coverage && pnpm run build",
    "qa:strict": "pnpm run qa:standard && pnpm run test:e2e && pnpm run test:accessibility && pnpm run test:performance && pnpm run test:seo && pnpm run validate:w3c",
    "validate:w3c": "node scripts/validate-w3c.js",
    "test:w3c": "node scripts/validate-w3c.js",
    "certs:generate": "node scripts/generate-certs.js",
    "lighthouse": "node scripts/run-lighthouse.js https://localhost:3000 --output=html --output-path=./reports/lighthouse.html --chrome-flags='\"--headless=new --no-sandbox\"'",
    "lighthouse:ci": "node scripts/run-lighthouse.js https://localhost:3000 --output=json --output-path=./reports/lighthouse.json --chrome-flags='\"--headless=new --no-sandbox\"' --preset=desktop",
    "audit:security": "pnpm audit --audit-level critical",
    "audit:dependencies": "pnpm audit",
    "legal:snapshot-terms": "node scripts/snapshot-terms.mjs",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.js"
  },
  "dependencies": {
    "framer-motion": "^14.9.0",
    "i18next": "^26.6.0",
    "i18next-browser-languagedetector": "^8.2.4",
    "i18next-http-backend": "^4.0.7",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.1.10",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vnu-jar": "^26.10.12"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=12.11.2"
  }
}
